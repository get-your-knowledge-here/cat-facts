{
  "name": "@gykh/cat-facts",
  "version": "2.0.0",
  "description": "🐱 Zero-dependency, offline cat facts for Node.js: random facts, fact of the day, search, TypeScript types and a CLI.",
  "main": "index.js",
  "types": "./index.d.ts",
  "bin": {
    "cat-facts": "bin/cat-facts.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/cat-facts.js",
    "facts.js",
    "index.js",
    "index.mjs",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "sync-docs": "node scripts/sync-docs.js"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.3.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-your-knowledge-here/cat-facts.git"
  },
  "keywords": [
    "cat",
    "cats",
    "cat-facts",
    "facts",
    "random",
    "fun-facts",
    "fact-of-the-day",
    "trivia",
    "offline",
    "cli",
    "typescript",
    "zero-dependencies"
  ],
  "author": {
    "name": "Sylvester Das",
    "email": "sylvester.das@gmail.com",
    "url": "https://www.sylvesterdas.com"
  },
  "funding": "https://www.buymeacoffee.com/sylvester.das",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/get-your-knowledge-here/cat-facts/issues"
  },
  "homepage": "https://gykh.sylvesterdas.com/cat-facts/"
}
